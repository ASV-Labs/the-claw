# TypeSafe Jev — POST https://api.typesafe.ai/v1/systemone
# Get a key at https://console.typesafe.ai
# Without this key the app uses a local heuristic so the pile still moves.
TYPESAFE_API_KEY=

# Optional. If set, Jev is called through Vercel AI Gateway instead.
# AI_GATEWAY_API_KEY=

# Optional pin. Default is jev-latest.
# JEV_MODEL=jev-1.13.0

# Optional. Live movies/TV via TMDB (https://www.themoviedb.org/settings/api).
# Without it, THE CLAW uses iTunes top movies and TVMaze (IMDb ids when present).
# TMDB_API_KEY=
# TMDB_READ_TOKEN=

# Optional. Nearby restaurants/bars via Google Places.
# Without it, THE CLAW uses OpenStreetMap around the phone's location.
# GOOGLE_PLACES_API_KEY=
